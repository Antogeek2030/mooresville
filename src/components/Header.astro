---
import HeaderLink from './HeaderLink.astro';
import { SITE_TITLE, BUSINESS_PHONE, BUSINESS_PHONE_TEL } from '../consts';
---

<header>
	<nav>
		<a href="/" class="logo">{SITE_TITLE}</a>
		<div class="internal-links">
			<HeaderLink href="/">Home</HeaderLink>
			<HeaderLink href="/services">Services</HeaderLink>
			<HeaderLink href="/service-areas">Service Areas</HeaderLink>
			<HeaderLink href="/blog">Blog</HeaderLink>
			<HeaderLink href="/contact">Contact Us</HeaderLink>
		</div>
		<a href={`tel:${BUSINESS_PHONE_TEL}`} class="phone-btn">{BUSINESS_PHONE}</a>
	</nav>
</header>

<style>
	header {
		margin: 0;
		padding: 0 1em;
		background: #0d47a1;
		box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		max-width: 1100px;
		margin: 0 auto;
		padding: 0.75em 0;
		flex-wrap: wrap;
		gap: 0.5em;
	}
	.logo {
		font-size: 1.15em;
		font-weight: 700;
		color: #fff;
		text-decoration: none;
		margin: 0;
	}
	.logo:hover {
		color: #bbdefb;
	}
	.internal-links {
		display: flex;
		flex-wrap: wrap;
		gap: 0.25em 1em;
	}
	.internal-links a {
		color: #e3f2fd;
		text-decoration: none;
		font-size: 0.95em;
		padding: 0.25em 0;
	}
	.internal-links a:hover,
	.internal-links a.active {
		color: #fff;
		text-decoration: underline;
	}
	.phone-btn {
		background: #ff6f00;
		color: #fff !important;
		padding: 0.4em 0.9em;
		border-radius: 4px;
		font-weight: 700;
		text-decoration: none;
		font-size: 0.95em;
		white-space: nowrap;
	}
	.phone-btn:hover {
		background: #e65100;
		color: #fff !important;
	}
	@media (max-width: 700px) {
		nav {
			flex-direction: column;
			align-items: flex-start;
		}
		.internal-links {
			width: 100%;
		}
	}
</style>
