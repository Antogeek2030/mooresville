---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import {
	SITE_TITLE,
	BUSINESS_PHONE,
	BUSINESS_PHONE_TEL,
} from '../../consts';

const title = `AC Repair Mooresville NC | Same-Day Air Conditioning Service`;
const description =
	"Fast, reliable AC repair in Mooresville NC. Same-day service for weak cooling, strange noises, frozen coils, and more. Call (704) 799-0123.";
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
	</head>
	<body>
		<Header />
		<main>
			<nav class="breadcrumb">
				<a href="/">Home</a> → <a href="/services">Services</a> → AC Repair
			</nav>
			<h1>AC Repair in Mooresville, NC</h1>
			<p class="lead">
				When your air conditioner stops cooling, you need help fast. We provide same-day
				AC repair for homes and businesses throughout Mooresville and the Lake Norman area.
			</p>

			<section>
				<h2>Common AC Problems We Fix</h2>
				<ul>
					<li>Weak or warm airflow from vents</li>
					<li>Unit runs but does not cool</li>
					<li>Frozen evaporator coils</li>
					<li>Strange noises (grinding, squealing, rattling)</li>
					<li>Frequent short cycling</li>
					<li>Water leaks around the indoor unit</li>
					<li>Thermostat not responding</li>
					<li>High energy bills from an inefficient system</li>
				</ul>
			</section>

			<section>
				<h2>How Our AC Repair Service Works</h2>
				<ol>
					<li><strong>Call or request a quote</strong> — We often schedule same-day visits.</li>
					<li><strong>Diagnosis</strong> — A trained technician inspects the system and explains the issue clearly.</li>
					<li><strong>Transparent pricing</strong> — You approve the repair before any work begins.</li>
					<li><strong>Quality repair</strong> — We fix the problem and test the system thoroughly.</li>
				</ol>
			</section>

			<section>
				<h2>Brands We Service</h2>
				<p>
					We repair all major air conditioning brands including Carrier, Trane, Lennox,
					Rheem, Goodman, York, American Standard, and more.
				</p>
			</section>

			<section class="cta-box">
				<h2>Need AC Repair Today?</h2>
				<p>Call now for same-day service in Mooresville.</p>
				<div class="cta-buttons">
					<a href={`tel:${BUSINESS_PHONE_TEL}`} class="btn btn-call">Call {BUSINESS_PHONE}</a>
					<a href="/contact#quote" class="btn btn-quote">Get a Quote</a>
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	main { max-width: 800px; margin: 0 auto; padding: 2em 1em; }
	.breadcrumb { font-size: 0.9em; margin-bottom: 1.5em; color: #555; }
	.breadcrumb a { color: #0d47a1; text-decoration: none; }
	.breadcrumb a:hover { text-decoration: underline; }
	h1 { color: #0d47a1; margin-bottom: 0.4em; }
	.lead { font-size: 1.1em; margin-bottom: 1.75em; }
	section { margin-bottom: 2em; }
	h2 { color: #1565c0; font-size: 1.3em; margin: 0 0 0.5em; }
	ul, ol { padding-left: 1.4em; line-height: 1.7; }
	.cta-box { text-align: center; background: #f5f9ff; padding: 2em 1em; border-radius: 8px; }
	.cta-box h2 { color: #0d47a1; }
	.cta-buttons { display: flex; flex-wrap: wrap; gap: 0.75em; justify-content: center; margin-top: 1em; }
	.btn { display: inline-block; padding: 0.7em 1.4em; border-radius: 6px; font-weight: 700; text-decoration: none; font-size: 1.05em; }
	.btn-call { background: #ff6f00; color: #fff; }
	.btn-call:hover { background: #e65100; color: #fff; }
	.btn-quote { background: #0d47a1; color: #fff; }
	.btn-quote:hover { background: #1565c0; color: #fff; }
</style>
